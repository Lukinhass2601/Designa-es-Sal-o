<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DesignacoesSR.Pages.HabilitacoesPage"
    Title="Habilitações">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="Participante"
            FontAttributes="Bold" />

        <Picker
            x:Name="pickerParticipante"
            Title="Selecione o participante"
            SelectedIndexChanged="pickerParticipante_SelectedIndexChanged" />

        <CollectionView x:Name="listaPartes">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="{Binding Nome}" />

                        <CheckBox
                            Grid.Column="1"
                            IsChecked="{Binding Selecionado}" />

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Text="Salvar Habilitações"
            Clicked="Salvar_Clicked" />

    </VerticalStackLayout>

</ContentPage>