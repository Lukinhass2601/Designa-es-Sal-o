<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DesignacoesSR.Pages.HistoricoPage"
    Title="Histórico">

    <Grid
        Padding="20"
        RowDefinitions="Auto,160,Auto,Auto,*"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Semanas Geradas"
            FontSize="22"
            FontAttributes="Bold" />

        <CollectionView
            Grid.Row="1"
            x:Name="listaSemanas"
            SelectionMode="Single"
            SelectionChanged="listaSemanas_SelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        Padding="10"
                        Margin="0,3"
                        BackgroundColor="#EEEEEE">

                        <Label
                            Text="{Binding StringFormat='{0:dd/MM/yyyy}'}"
                            FontSize="16"
                            FontAttributes="Bold" />

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Label
            Grid.Row="2"
            x:Name="lblSemanaSelecionada"
            Text="Selecione uma semana para visualizar"
            FontSize="18"
            FontAttributes="Bold" />

        <Button
            Grid.Row="3"
            x:Name="btnExcluirSemana"
            Text="Excluir Semana Selecionada"
            Clicked="ExcluirSemana_Clicked"
            IsEnabled="False" />

        <CollectionView
            Grid.Row="4"
            x:Name="listaDesignacoes"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        Padding="12"
                        Margin="0,4"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="6"
                        BackgroundColor="#F5F5F5">

                        <Label
                            Grid.Row="0"
                            Text="{Binding Parte}"
                            FontSize="17"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap" />

                        <Label
                            Grid.Row="1"
                            Text="{Binding Participante}"
                            FontSize="15"
                            LineBreakMode="WordWrap" />

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>