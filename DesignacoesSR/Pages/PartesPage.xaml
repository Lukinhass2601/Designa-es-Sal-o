<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DesignacoesSR.Pages.PartesPage"
    Title="Partes">

    <CollectionView
        x:Name="listaPartes"
        Margin="10">

        <CollectionView.ItemTemplate>

            <DataTemplate>

                <Frame Margin="5">

                    <HorizontalStackLayout Spacing="10">

                        <Label
                            Text="{Binding Nome}"
                            WidthRequest="180"
                            VerticalOptions="Center"/>

                        <Button
                            Text="Editar"
                            CommandParameter="{Binding .}"
                            Clicked="EditarParte_Clicked"/>

                        <Button
                            Text="Excluir"
                            CommandParameter="{Binding .}"
                            Clicked="ExcluirParte_Clicked"/>

                    </HorizontalStackLayout>

                </Frame>

            </DataTemplate>

        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>