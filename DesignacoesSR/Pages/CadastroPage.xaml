<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DesignacoesSR.Pages.CadastroPage"
    Title="Cadastros">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Novo Participante"
                FontSize="20"
                FontAttributes="Bold"/>

            <Entry
                x:Name="txtParticipante"
                Placeholder="Nome do participante"/>

            <Button
                Text="Salvar Participante"
                Clicked="SalvarParticipante_Clicked"/>

            <BoxView HeightRequest="1"/>

            <Label
                Text="Nova Parte"
                FontSize="20"
                FontAttributes="Bold"/>

            <Entry
                x:Name="txtParte"
                Placeholder="Nome da parte"/>

            <Button
                Text="Salvar Parte"
                Clicked="SalvarParte_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>